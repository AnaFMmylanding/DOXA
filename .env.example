# DOXA Atelier — Variables de Entorno para Stripe (Ejemplo)
# Copia este archivo como .env e introduce tus claves reales de Stripe

# Clave secreta de Stripe (obtenida en tu panel de desarrollador de Stripe)
STRIPE_SECRET_KEY=tu_clave_secreta_stripe_aqui

# Clave pública de Stripe (opcional, para uso en frontend si se requiere)
STRIPE_PUBLISHABLE_KEY=tu_clave_publica_stripe_aqui

# Puerto para el servidor local
PORT=3000
